configuration {
    show-icons: false;
}

* {
    background-color: transparent;
    text-color:       #ffffff;
    font:             "Tengoku 11";
}

window {
    width:            320px;
    background-color: @background;
    border:           2px;
    border-color:     @border-color;
    border-radius:    2px;
    padding:          16px;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [ listview ];
}

listview {
    lines:            5;
    spacing:          8px;
    cycle:            true;
    dynamic:          true;
    border:           0px;
}

element {
    padding:          10px 14px;
    border-radius:    2px;
    background-color: #171811;
    text-color:       #d0d0d0;
    border:           0px;
}

element selected {
    background-color: #171811;
    text-color:       #ffffff;
    border:           1px;
    border-color:     @border-color;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;

}
@import "skwd-colors.rasi"

