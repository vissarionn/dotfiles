configuration {
    show-icons: false;
}

* {
    background-color: transparent;
    text-color:       #ffffff;
    font:             "Tengoku 11";
}

window {
    fullscreen:       true;
    background-color: #23262980; /* Alpha 80 (~50% opacity) for transparency */
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [ listview ];
    spacing:          0;
    padding:          350 500;
}

listview {
    columns:          1;
    lines:            5;
    spacing:          24;
    cycle:            true;
    dynamic:          false;
    scrollbar:        false;
    border:           0;
}

element {
    padding:          8 0;
    background-color: transparent;
    text-color:       #a0a0a0;
    border:           0;
}

element selected {
    background-color: transparent;
    text-color:       @border-color;
    border:           0;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}

@import "skwd-colors.rasi"
