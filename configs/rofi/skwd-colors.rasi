* {
    background:                  #12140e;
    background-alt:              #1e2019;
    foreground:                  #e3e3d8;
    selected:                    #b6d086;
    active:                      #a0d0c9;
    urgent:                      #ffb4ab;
    lightbg:                     #1e2019;
    lightfg:                     #b6d086;
    red:                         #ffb4ab;
    blue:                        #a0d0c9;
    border-color:                #b6d086;
    separatorcolor:              #8f9284;
    normal-background:           #12140e;
    normal-foreground:           #e3e3d8;
    alternate-normal-background: #1e2019;
    alternate-normal-foreground: #e3e3d8;
    selected-normal-background:  #b6d086;
    selected-normal-foreground:  #233600;
    active-background:           #12140e;
    active-foreground:           #a0d0c9;
    alternate-active-background: #1e2019;
    alternate-active-foreground: #a0d0c9;
    selected-active-background:  #a0d0c9;
    selected-active-foreground:  #013733;
    urgent-background:           #12140e;
    urgent-foreground:           #ffb4ab;
    alternate-urgent-background: #1e2019;
    alternate-urgent-foreground: #ffb4ab;
    selected-urgent-background:  #ffb4ab;
    selected-urgent-foreground:  #690005;
}
